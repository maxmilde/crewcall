# Copy to .env and fill in. Never commit .env.

# Featherless (OpenAI-compatible API)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=            # chosen on the day

# Apify
APIFY_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=             # bot username without @, for invite links
OWNER_CHAT_ID=                 # the phone that plays the owner in the demo

# Work inbox for client requests (a Google app password, not the account password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Agent settings
COMPANY_NAME="[Company]"        # shown on the simulated contract and assignment
DOMAIN=cleaning                # picks data/domains/<name>.json; e.g. events
CITY=Prague
MAX_TRAVEL_MINUTES=45
PAY_TEXT=                      # optional; overrides the domain pay text
FB_POST_URL=                  # a public Facebook post for the demo
